{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Studio Pro",
  "mainBinaryName": "MediaStudioPro",
  "version": "0.1.0",
  "identifier": "com.mediastudiopro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Media Studio Pro",
        "width": 1480,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://thumb.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost http://thumb.localhost; font-src 'self' data:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Media Studio Pro",
    "copyright": "© 2026 Media Studio Pro",
    "category": "Video",
    "shortDescription": "Browse, review and edit images, video and audio",
    "longDescription": "Media Studio Pro is a local-first media library, review and editing application for Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
